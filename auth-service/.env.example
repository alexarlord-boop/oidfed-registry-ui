# Application
APP_NAME="OIDC Federation Auth Service"
DEBUG=false

# Database - Choose one:
# SQLite (simple, file-based)
DATABASE_URL=sqlite+aiosqlite:///./data/auth.db

# PostgreSQL (production-ready)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/authdb

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8001/auth/oidc/github/callback

# Keycloak OAuth
KEYCLOAK_SERVER_URL=https://keycloak.example.com
KEYCLOAK_REALM=myrealm
KEYCLOAK_CLIENT_ID=auth-service
KEYCLOAK_CLIENT_SECRET=your-keycloak-secret
KEYCLOAK_REDIRECT_URI=http://localhost:8001/auth/oidc/keycloak/callback
